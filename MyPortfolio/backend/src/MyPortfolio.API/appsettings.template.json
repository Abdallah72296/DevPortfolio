{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_HOST;Database=YOUR_DATABASE_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Issuer": "MyPortfolioAPI",
    "Audience": "MyPortfolioClient",
    "Key": "REPLACE_WITH_A_SECURE_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG!",
    "ExpiryInMinutes": 1440
  },
  "Admin": {
    "Email": "admin@yourportfolio.com",
    "Password": "REPLACE_WITH_SECURE_ADMIN_PASSWORD"
  },
  "Email": {
    "FrontendBaseUrl": "http://localhost:4200",
    "Resend": {
      "ApiKey": "SET_WITH_USER_SECRETS_OR_ENVIRONMENT_VARIABLE",
      "From": "DevFolio <onboarding@resend.dev>"
    },
    "Smtp": {
      "Host": "YOUR_SMTP_HOST",
      "Port": 587,
      "Username": "YOUR_SMTP_USERNAME",
      "Password": "SET_WITH_USER_SECRETS_OR_ENVIRONMENT_VARIABLE",
      "From": "no-reply@yourportfolio.com",
      "EnableSsl": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-angular-domain.monsterasp.net",
      "http://localhost:4200"
    ]
  },
  "AI": {
    "Provider": "Gemini",
    "Model": "gemini-flash-latest",
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
